# Ignore Next.js clone folder (do not upload)
clone-Nodejs/

# Ignore Streamlit local config and runtime files
!.streamlit/
!.streamlit/config.toml
.streamlit/secrets.toml
.DeutschFlash_Fast_Stack/
.DeutschFlash_Personal_Deploy/

# Generated slide assets (re-created from German.pptx on startup)
static/slides/

# Local-only dev marker — NEVER commit this; its absence means "deployed"
.local_dev

# Node artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Next.js build
.next/

# Python artifacts (original project contains Python files)
__pycache__/
*.py[cod]
*.pyo
*.pyd

# OS files #
.DS_Store
Thumbs.db
