# Ignore Next.js clone folder (do not upload)
clone-Nodejs/

# Ignore Streamlit local config and runtime files
!.streamlit/
!.streamlit/config.toml
.streamlit/secrets.toml
.DeutschFlash_Fast_Stack/
.DeutschFlash_Personal_Deploy/

# Generated slide assets — committed so deployment has them without needing LibreOffice
# Only the intermediate PNG cache is ignored (it's always temporary)
data/slides_cache/
data/German.pptx

# Local-only dev marker — NEVER commit; its absence = deployment
.local_dev

# Node artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Next.js build
.next/

# Python artifacts (original project contains Python files)
__pycache__/
*.py[cod]
*.pyo
*.pyd

# OS files #
.DS_Store
Thumbs.db
data/German.pptx
